<!doctype html>
<html lang="en">
<head><%- include('partials/head') %></head>
<body>
<%- include('partials/nav') %>
<section class="container" style="padding-top:2rem; padding-bottom:5rem;">
  <a href="/challenges" class="muted-note" style="display:inline-flex; align-items:center; gap:6px; margin-bottom:1rem;">← Back to lab explorer</a>

  <% if (notice === 'stopped') { %>
    <div class="form-success">Lab instance stopped. Start it again when you are ready.</div>
  <% } %>

  <div class="lab-workspace">
    <aside class="glass-strong panel lab-brief">
      <div class="badge-row">
        <span class="level-tag level-<%= challenge.level %>">L<%= challenge.level %></span>
        <span class="badge badge-<%= challenge.difficulty.toLowerCase() %>"><%= challenge.difficulty %></span>
        <span class="badge badge-domain"><%= challenge.domain %></span>
        <% if (solved) { %><span class="badge badge-solved">✓ Solved</span><% } %>
        <% if (locked) { %><span class="badge badge-locked">Locked</span><% } %>
      </div>

      <h1 style="font-size:clamp(1.45rem,3vw,2.1rem); margin-top:0.7rem;"><%= challenge.title %></h1>
      <p class="mono muted-note" style="font-size:0.76rem;"><%= challenge.owaspRef %><% if (challenge.owaspApiRef) { %> · <%= challenge.owaspApiRef %><% } %></p>

      <div class="divider"></div>

      <p style="color:var(--text-primary); line-height:1.65;"><%= challenge.briefing %></p>
      <% if (challenge.scenario) { %>
        <p><strong>Scenario.</strong> <%= challenge.scenario %></p>
      <% } %>

      <h3 class="minor-heading">Objectives</h3>
      <ul class="objective-list">
        <% (challenge.objectives || []).forEach(objective => { %><li><%= objective %></li><% }) %>
      </ul>

      <% if (challenge.prerequisites && challenge.prerequisites.length) { %>
        <h3 class="minor-heading">Prerequisites</h3>
        <div class="prereq-list">
          <% challenge.prerequisites.forEach(slug => { %>
            <a class="badge <%= missingPrerequisites.includes(slug) ? 'badge-locked' : 'badge-solved' %>" href="/challenges/<%= slug %>">
              <%= missingPrerequisites.includes(slug) ? 'Locked' : 'Done' %> · <%= slug %>
            </a>
          <% }) %>
        </div>
      <% } %>

      <h3 class="minor-heading">Threat mapping</h3>
      <div class="mapping-grid">
        <div><span>OWASP</span><strong><%= challenge.owaspRef || '—' %></strong></div>
        <div><span>ASVS</span><strong><%= challenge.asvsRef || '—' %></strong></div>
        <div><span>WSTG</span><strong><%= challenge.wstgRef || '—' %></strong></div>
        <div><span>CWE</span><strong><%= challenge.cwe || '—' %></strong></div>
        <div><span>ATT&amp;CK</span><strong><%= challenge.attackTechnique || '—' %></strong></div>
        <div><span>Est. time</span><strong><%= challenge.estimatedMinutes %> min</strong></div>
      </div>

      <h3 class="minor-heading">Hints</h3>
      <div id="hintList">
        <% (challenge.hints || []).slice(0, revealedHints).forEach((hint, index) => { %>
          <div class="hint-card"><span class="badge badge-domain">Hint <%= index + 1 %></span><p><%= hint %></p></div>
        <% }) %>
        <% if (revealedHints === 0) { %><p class="muted-note" id="noHints">No hints unlocked. Use the button if you are stuck.</p><% } %>
      </div>
      <% if (revealedHints < (challenge.hints || []).length) { %>
        <button type="button" class="btn btn-ghost btn-sm" id="hintBtn" data-slug="<%= challenge.slug %>">Reveal next hint (<%= revealedHints %>/<%= challenge.hints.length %>)</button>
      <% } else { %>
        <p class="muted-note" style="font-size:0.8rem;">All hints revealed.</p>
      <% } %>
    </aside>

    <div class="lab-access-column">
      <aside class="glass panel">
        <div class="section-head" style="margin-bottom:0.75rem;">
          <h3 style="margin:0;">Lab instance</h3>
          <span class="badge <%= activeInstance ? 'badge-solved' : 'badge-domain' %>"><%= activeInstance ? 'Ready' : 'Not started' %></span>
        </div>

        <div class="metadata-grid">
          <div class="metadata-item"><span class="metadata-label">Target</span><span class="metadata-value mono"><%= challenge.labPath %></span></div>
          <div class="metadata-item"><span class="metadata-label">Flag binding</span><span class="metadata-value">User + lab + instance</span></div>
          <div class="metadata-item"><span class="metadata-label">Instance TTL</span><span class="metadata-value"><%= activeInstance ? new Date(activeInstance.expiresAt).toLocaleString() : 'Created on launch' %></span></div>
          <div class="metadata-item"><span class="metadata-label">Reward</span><span class="metadata-value mono" style="color:var(--amber);">+<%= challenge.points %> pts</span></div>
        </div>

        <% if (locked) { %>
          <div class="form-error" style="margin-top:1rem;">Complete <strong><%= missingPrerequisites.join(', ') %></strong> before launching this lab.</div>
          <button class="btn btn-primary btn-block" disabled>Prerequisites required</button>
        <% } else { %>
          <form method="POST" action="/challenges/<%= challenge.slug %>/start" style="margin-top:1rem;">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-primary btn-block"><%= activeInstance ? 'Open lab target' : 'Start lab instance' %></button>
          </form>
          <% if (activeInstance) { %>
            <div class="instance-actions">
              <a class="btn btn-ghost btn-sm" href="<%= challenge.labPath %>" target="_blank" rel="noopener">Open in new tab</a>
              <form method="POST" action="/challenges/<%= challenge.slug %>/reset">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-danger btn-sm">Reset instance</button>
              </form>
              <form method="POST" action="/challenges/<%= challenge.slug %>/stop">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-ghost btn-sm">Stop</button>
              </form>
            </div>
            <p class="muted-note" style="font-size:0.76rem; margin-top:0.6rem;">Resetting rotates the instance key and invalidates every previously observed flag.</p>
          <% } %>
        <% } %>
      </aside>

      <aside class="glass panel">
        <h3>Submit flag</h3>
        <% if (solved) { %>
          <div class="form-success" style="margin:0;">Flag accepted. This lab is complete.</div>
          <% if (solution) { %>
            <details class="solution-box" open>
              <summary>Post-completion writeup</summary>
              <p><%= solution %></p>
            </details>
          <% } %>
        <% } else { %>
          <p class="muted-note" style="font-size:0.86rem;">Submit the flag extracted from the target. Validation happens server-side against your active instance.</p>
          <div class="flag-box">
            <input id="flag" name="flag" placeholder="ZDS{...}" autocomplete="off">
            <button type="button" id="submitFlagBtn" class="btn btn-primary">Submit</button>
          </div>
          <div id="flagStatus" class="flag-status"></div>
        <% } %>
      </aside>
    </div>
  </div>
</section>
<%- include('partials/footer') %>
<script>
(function () {
  var csrf = <%- JSON.stringify(csrfToken) %>;
  var slug = <%- JSON.stringify(challenge.slug) %>;
  var submitBtn = document.getElementById('submitFlagBtn');
  var flagInput = document.getElementById('flag');
  var statusBox = document.getElementById('flagStatus');

  function post(url, body) {
    return fetch(url, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/x-www-form-urlencoded',
        'X-CSRF-Token': csrf,
        'Accept': 'application/json'
      },
      body: body
    });
  }

  if (submitBtn) {
    var submit = function () {
      var flag = flagInput.value.trim();
      if (!flag) { statusBox.innerHTML = '<div class="form-error">Enter a flag first.</div>'; return; }
      submitBtn.disabled = true;
      submitBtn.textContent = 'Checking…';
      post('/challenges/' + slug + '/submit', 'flag=' + encodeURIComponent(flag))
        .then(function (response) { return response.json(); })
        .then(function (data) {
          if (data.ok) {
            if (data.alreadySolved) {
              statusBox.innerHTML = '<div class="form-success">Already solved.</div>';
            } else {
              statusBox.innerHTML = '<div class="form-success">' + data.message + ' +' + data.points + ' points. Reloading…</div>';
              setTimeout(function () { location.reload(); }, 800);
            }
          } else {
            statusBox.innerHTML = '<div class="form-error">' + data.message + '</div>';
            submitBtn.disabled = false;
            submitBtn.textContent = 'Submit';
          }
        })
        .catch(function () {
          statusBox.innerHTML = '<div class="form-error">Network error. Try again.</div>';
          submitBtn.disabled = false;
          submitBtn.textContent = 'Submit';
        });
    };
    submitBtn.addEventListener('click', submit);
    flagInput.addEventListener('keydown', function (event) { if (event.key === 'Enter') submit(); });
  }

  var hintBtn = document.getElementById('hintBtn');
  if (hintBtn) {
    hintBtn.addEventListener('click', function () {
      hintBtn.disabled = true;
      post('/challenges/' + slug + '/hint', '')
        .then(function (response) { return response.json(); })
        .then(function (data) {
          if (!data.ok) throw new Error(data.message || 'Could not reveal hint.');
          var noHints = document.getElementById('noHints');
          if (noHints) noHints.remove();
          var card = document.createElement('div');
          card.className = 'hint-card';
          var badge = document.createElement('span');
          badge.className = 'badge badge-domain';
          badge.textContent = 'Hint ' + data.revealed;
          var text = document.createElement('p');
          text.textContent = data.hint;
          card.appendChild(badge);
          card.appendChild(text);
          document.getElementById('hintList').appendChild(card);
          if (data.revealed >= data.total) {
            hintBtn.parentNode.replaceChild(Object.assign(document.createElement('p'), {
              className: 'muted-note', textContent: 'All hints revealed.'
            }), hintBtn);
          } else {
            hintBtn.textContent = 'Reveal next hint (' + data.revealed + '/' + data.total + ')';
            hintBtn.disabled = false;
          }
        })
        .catch(function (error) {
          hintBtn.disabled = false;
          alert(error.message);
        });
    });
  }
})();
</script>
</body>
</html>
