<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AvatarSync — Import</title>
<link rel="stylesheet" href="/css/lab.css">
</head>
<body data-theme="ssrf">
<div class="lab-topbar"><a class="lab-back" href="/challenges">&larr; ZeroDay Academy</a><span class="name">AvatarSync</span><span class="tag">/labs/ssrf-metadata</span></div>
<div class="lab-wrap">
  <div class="lab-card">
    <h1>Import Avatar</h1>
    <p>Paste a URL to import your avatar image from the web.</p>
    <form method="POST" action="/labs/ssrf-metadata">
      <label>Image URL</label>
      <input name="url" placeholder="https://example.com/avatar.jpg" value="<%= url %>" autocomplete="off">
      <button type="submit">Import</button>
    </form>
    <% if (error) { %><div class="lab-alert error"><%= error %></div><% } %>
  </div>

  <% if (result) { %>
  <div class="lab-card">
    <h2>Server Response</h2>
    <p class="lab-meta">Status: <%= result.status %></p>
    <pre style="white-space:pre-wrap;word-break:break-all;font-size:0.85rem;"><%= result.body %></pre>
  </div>
  <% } %>

</body>
</html>
