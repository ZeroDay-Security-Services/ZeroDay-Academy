<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>InvoicePDF — Generate</title>
<link rel="stylesheet" href="/css/lab.css">
</head>
<body data-theme="ssrf">
<div class="lab-topbar"><a class="lab-back" href="/challenges">&larr; ZeroDay Academy</a><span class="name">InvoicePDF</span><span class="tag">/labs/ssrf-pdf-generator</span></div>
<div class="lab-wrap">
  <div class="lab-card">
    <h1>Generate Invoice PDF</h1>
    <p>Paste your invoice HTML markup to render a PDF.</p>
    <form method="POST" action="/labs/ssrf-pdf-generator">
      <label>Invoice HTML</label>
      <textarea name="html" rows="8"><%= html %></textarea>
      <button type="submit">Render</button>
    </form>
    <% if (error) { %><div class="lab-alert error"><%= error %></div><% } %>
  </div>

  <% if (fetched) { %>
  <div class="lab-card">
    <h2>Renderer Output</h2>
    <p class="lab-meta">Fetched resource: <code><%= fetched.url %></code></p>
    <pre style="white-space:pre-wrap;word-break:break-all;font-size:0.85rem;"><%= fetched.body %></pre>
  </div>
  <% } %>

</body>
</html>
