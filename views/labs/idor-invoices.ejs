<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>InvoiceHub — Your Invoices</title>
<link rel="stylesheet" href="/css/lab.css">
</head>
<body data-theme="idor">
<div class="lab-topbar"><a class="lab-back" href="/challenges">&larr; ZeroDay Academy</a><span class="name">InvoiceHub</span><span class="tag">/labs/idor-invoices</span></div>
<div class="lab-wrap">
  <div class="lab-card">
    <h1>Your Invoices</h1>
    <ul class="lab-list">
      <% myInvoices.forEach(inv => { %>
        <li><a href="/labs/idor-invoices/<%= inv.data.id %>"><%= inv.data.id %></a> — $<%= inv.data.amount %> (<%= inv.data.status %>)</li>
      <% }) %>
    </ul>
  </div>

  <% if (selectedInvoice) { %>
  <div class="lab-card">
    <h2>Invoice Detail</h2>
    <table class="lab-table">
      <tr><th>Field</th><th>Value</th></tr>
      <% Object.entries(selectedInvoice).forEach(([k,v]) => { %>
        <tr><td><%= k %></td><td><%= v %></td></tr>
      <% }) %>
    </table>
  </div>
  <% } %>

  <% if (error) { %><div class="lab-card"><div class="lab-alert error"><%= error %></div></div><% } %>

</body>
</html>
