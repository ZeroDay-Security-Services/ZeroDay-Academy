<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NetOps — Diagnostics</title>
<link rel="stylesheet" href="/css/lab.css">
</head>
<body data-theme="injection">
<div class="lab-topbar"><a class="lab-back" href="/challenges">&larr; ZeroDay Academy</a><span class="name">NetOps Dashboard</span><span class="tag">/labs/cmd-injection</span></div>
<div class="lab-wrap">
  <div class="lab-card">
    <h1>Network Diagnostics</h1>
    <p>Run a connectivity check against any host.</p>
    <form method="POST" action="/labs/cmd-injection">
      <label>Target host</label>
      <input name="host" placeholder="e.g. 8.8.8.8" value="<%= host %>" autocomplete="off">
      <button type="submit">Run check</button>
    </form>
    <% if (error) { %><div class="lab-alert error"><%= error %></div><% } %>
  </div>

  <% if (output) { %>
  <div class="lab-card">
    <h2>Output</h2>
    <pre style="white-space:pre-wrap;word-break:break-all;font-size:0.85rem;"><%= output %></pre>
  </div>
  <% } %>

</body>
</html>
