<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SecureAuth — Password Reset</title>
<link rel="stylesheet" href="/css/lab.css">
</head>
<body data-theme="auth">
<div class="lab-topbar"><a class="lab-back" href="/challenges">&larr; ZeroDay Academy</a><span class="name">SecureAuth</span><span class="tag">/labs/broken-password-reset</span></div>
<div class="lab-wrap">
  <div class="lab-card">
    <h1>Password Reset</h1>
    <p>Enter a username to receive a password reset link.</p>
    <form method="POST" action="/labs/broken-password-reset/request-reset">
      <label>Username</label>
      <input name="username" placeholder="e.g. guest" autocomplete="off">
      <button type="submit">Request reset</button>
    </form>
    <% if (issuedToken) { %>
      <div class="lab-alert info" style="margin-top:1rem;">Reset email sent. Your token: <code><%= issuedToken %></code></div>
    <% } %>
  </div>

  <div class="lab-card">
    <h2>Complete Reset</h2>
    <form method="POST" action="/labs/broken-password-reset/complete-reset">
      <label>Reset token</label>
      <input name="token" placeholder="Enter reset token" autocomplete="off">
      <label>New password</label>
      <input name="newPassword" type="password">
      <button type="submit">Reset password</button>
    </form>
    <% if (error) { %><div class="lab-alert error"><%= error %></div><% } %>
    <% if (result) { %>
      <div class="lab-alert success">
        Password reset for <strong><%= result.owner %></strong>.
        <% if (result.flag) { %><br>Flag: <span class="lab-flag"><%= result.flag %></span><% } %>
      </div>
    <% } %>
  </div>

</body>
</html>
