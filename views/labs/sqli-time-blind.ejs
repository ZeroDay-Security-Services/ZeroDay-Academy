<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>UserCheck — Account Lookup</title>
<link rel="stylesheet" href="/css/lab.css">
</head>
<body data-theme="injection">
<div class="lab-topbar"><a class="lab-back" href="/challenges">&larr; ZeroDay Academy</a><span class="name">UserCheck</span><span class="tag">/labs/sqli-time-blind</span></div>
<div class="lab-wrap">
  <div class="lab-card">
    <h1>Account Lookup</h1>
    <p>Check if an account exists in the system.</p>
    <form method="POST" action="/labs/sqli-time-blind/lookup">
      <label>Username</label>
      <input name="username" value="<%= username %>" placeholder="Enter username" autocomplete="off">
      <button type="submit">Look up</button>
    </form>
    <% if (error) { %><div class="lab-alert error"><%= error %></div><% } %>
    <% if (elapsedMs !== null) { %>
      <div class="lab-alert info">Request completed in <%= elapsedMs %>ms.</div>
    <% } %>
  </div>

  <div class="lab-card">
    <h2>Submit extracted value</h2>
    <form method="POST" action="/labs/sqli-time-blind/check">
      <label>Answer</label>
      <input name="answer" placeholder="Enter the extracted value" autocomplete="off">
      <button type="submit">Check</button>
    </form>
    <% if (checkResult) { %>
      <div class="lab-alert <%= checkResult.correct ? 'success' : 'error' %>">
        <%= checkResult.correct ? 'Correct!' : 'Incorrect.' %>
        <% if (checkResult.flag) { %><br>Flag: <span class="lab-flag"><%= checkResult.flag %></span><% } %>
      </div>
    <% } %>
  </div>

</body>
</html>
