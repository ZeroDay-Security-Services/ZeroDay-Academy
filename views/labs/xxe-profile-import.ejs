<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ProfileSync — Import</title>
<link rel="stylesheet" href="/css/lab.css">
</head>
<body data-theme="xxe">
<div class="lab-topbar"><a class="lab-back" href="/challenges">&larr; ZeroDay Academy</a><span class="name">ProfileSync</span><span class="tag">/labs/xxe-profile-import</span></div>
<div class="lab-wrap">
  <div class="lab-card">
    <h1>Import Profile</h1>
    <p>Paste your XML profile data to import.</p>
    <form method="POST" action="/labs/xxe-profile-import">
      <label>Profile XML</label>
      <textarea name="xml" rows="8" placeholder="Paste XML here"></textarea>
      <button type="submit">Import</button>
    </form>
    <% if (error) { %><div class="lab-alert error"><%= error %></div><% } %>
  </div>

  <% if (profileData) { %>
  <div class="lab-card">
    <h2>Imported Profile</h2>
    <table class="lab-table">
      <% Object.entries(profileData).forEach(([k,v]) => { %>
        <tr><td><%= k %></td><td><%= v %></td></tr>
      <% }) %>
    </table>
  </div>
  <% } %>

</body>
</html>
