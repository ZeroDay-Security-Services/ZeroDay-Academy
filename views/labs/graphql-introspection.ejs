<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DataQL — Query Console</title>
<link rel="stylesheet" href="/css/lab.css">
</head>
<body data-theme="api">
<div class="lab-topbar"><a class="lab-back" href="/challenges">&larr; ZeroDay Academy</a><span class="name">DataQL</span><span class="tag">/labs/graphql-introspection</span></div>
<div class="lab-wrap">
  <div class="lab-card">
    <h1>GraphQL Console</h1>
    <p>Query the DataQL API.</p>
    <form id="gqlForm">
      <label>Query</label>
      <textarea id="gqlQuery" rows="5" placeholder="{ publicAnnouncements }"></textarea>
      <button type="submit">Execute</button>
    </form>
  </div>

  <div class="lab-card">
    <h2>Response</h2>
    <pre id="gqlResult" style="white-space:pre-wrap;font-size:0.85rem;">Submit a query to see results.</pre>
  </div>
</div>

<script>
  document.getElementById('gqlForm').addEventListener('submit', function(e) {
    e.preventDefault();
    fetch('/labs/graphql-introspection/graphql', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ query: document.getElementById('gqlQuery').value })
    }).then(function(r) { return r.json(); })
      .then(function(d) { document.getElementById('gqlResult').textContent = JSON.stringify(d, null, 2); });
  });
</script>

</body>
</html>
