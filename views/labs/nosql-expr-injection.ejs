<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>VaultDB — Search</title>
<link rel="stylesheet" href="/css/lab.css">
</head>
<body data-theme="nosql">
<div class="lab-topbar"><a class="lab-back" href="/challenges">&larr; ZeroDay Academy</a><span class="name">VaultDB</span><span class="tag">/labs/nosql-expr-injection</span></div>
<div class="lab-wrap">
  <div class="lab-card">
    <h1>Vault Search</h1>
    <p>Search the vault using a JSON filter.</p>
    <form method="POST" action="/labs/nosql-expr-injection/probe">
      <label>Filter (JSON)</label>
      <textarea name="filter" rows="4" placeholder='{"kind":"vault"}'></textarea>
      <button type="submit">Search</button>
    </form>
    <% if (matchResult) { %>
      <% if (matchResult.error) { %>
        <div class="lab-alert error" style="margin-top:1rem;"><%= matchResult.error %></div>
      <% } else { %>
        <div class="lab-alert <%= matchResult.matched ? 'success' : 'info' %>" style="margin-top:1rem;">
          <%= matchResult.matched ? 'Record found.' : 'No matching record.' %>
        </div>
      <% } %>
    <% } %>
  </div>

  <div class="lab-card">
    <h2>Submit extracted secret</h2>
    <form method="POST" action="/labs/nosql-expr-injection/check">
      <label>Secret value</label>
      <input name="answer" placeholder="Enter the secret" autocomplete="off">
      <button type="submit">Verify</button>
    </form>
    <% if (checkResult) { %>
      <div class="lab-alert <%= checkResult.correct ? 'success' : 'error' %>">
        <%= checkResult.correct ? 'Correct!' : 'Incorrect.' %>
        <% if (checkResult.flag) { %><br>Flag: <span class="lab-flag"><%= checkResult.flag %></span><% } %>
      </div>
    <% } %>
  </div>

</body>
</html>
