<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CorpPortal — Dashboard</title>
<link rel="stylesheet" href="/css/lab.css">
</head>
<body data-theme="access">
<div class="lab-topbar"><a class="lab-back" href="/challenges">&larr; ZeroDay Academy</a><span class="name">CorpPortal</span><span class="tag">/labs/vertical-privesc</span></div>
<div class="lab-wrap">
  <div class="lab-card">
    <h1>User Dashboard</h1>
    <p>Logged in as: <strong>user</strong> (role: <%= role %>)</p>
    <ul class="lab-list">
      <li><a href="#">My Profile</a></li>
      <li><a href="#">My Projects</a></li>
      <li><a href="#">Notifications</a></li>
    </ul>
  </div>

  <div class="lab-card">
    <h2>Admin Functions</h2>
    <p class="lab-meta">The UI hides this panel from normal users, but the endpoint does not verify the caller's role.</p>
    <% if (flag) { %>
      <div class="lab-alert success">
        Admin action executed successfully.
        <br>Flag: <span class="lab-flag"><%= flag %></span>
      </div>
    <% } else { %>
      <div class="lab-alert info">The <code>POST /admin/grant-flag</code> endpoint is intended for administrators only.</div>
      <form method="POST" action="/labs/vertical-privesc/admin/grant-flag">
        <button type="submit" class="danger">Invoke admin action</button>
      </form>
    <% } %>
  </div>

  <form method="POST" action="/labs/vertical-privesc/reset"><button type="submit" class="secondary">Reset lab</button></form>
</div>
</body>
</html>
