<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MegaStore — Checkout</title>
<link rel="stylesheet" href="/css/lab.css">
</head>
<body data-theme="logic">
<div class="lab-topbar"><a class="lab-back" href="/challenges">&larr; ZeroDay Academy</a><span class="name">MegaStore</span><span class="tag">/labs/logic-negative-quantity</span></div>
<div class="lab-wrap">
  <div class="lab-card">
    <h1>Checkout</h1>
    <p>Your account balance: <strong>$<%= balance %></strong></p>
    <% if (flag) { %>
      <div class="lab-alert success">Flag: <span class="lab-flag"><%= flag %></span></div>
    <% } %>
    <form method="POST" action="/labs/logic-negative-quantity/checkout">
      <label>Product: Premium Widget ($89.00)</label>
      <label>Quantity</label>
      <input name="quantity" type="number" value="1">
      <button type="submit">Purchase</button>
    </form>
  </div>

  <form method="POST" action="/labs/logic-negative-quantity/reset"><button type="submit" class="secondary">Reset lab</button></form>

</body>
</html>
