<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AccountAPI — Settings</title>
<link rel="stylesheet" href="/css/lab.css">
</head>
<body data-theme="api">
<div class="lab-topbar"><a class="lab-back" href="/challenges">&larr; ZeroDay Academy</a><span class="name">AccountAPI</span><span class="tag">/labs/api-mass-assignment</span></div>
<div class="lab-wrap">
  <div class="lab-card">
    <h1>Account Settings</h1>
    <p>Account: <strong><%= account.id %></strong> — Tier: <strong><%= account.accountTier %></strong></p>
    <% if (flag) { %>
      <div class="lab-alert success">Enterprise tier unlocked. Flag: <span class="lab-flag"><%= flag %></span></div>
    <% } %>
    <form id="updateForm">
      <label>Display Name</label>
      <input id="displayName" value="<%= account.displayName || '' %>" placeholder="Your name">
      <button type="submit">Update</button>
    </form>
  </div>

  <form method="POST" action="/labs/api-mass-assignment/reset"><button type="submit" class="secondary">Reset lab</button></form>
</div>

<script>
  document.getElementById('updateForm').addEventListener('submit', function(e) {
    e.preventDefault();
    fetch('/labs/api-mass-assignment/api/account', {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ displayName: document.getElementById('displayName').value })
    }).then(function() { location.reload(); });
  });
</script>

</body>
</html>
