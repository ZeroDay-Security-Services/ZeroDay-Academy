<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MyAccount — Settings</title>
<link rel="stylesheet" href="/css/lab.css">
</head>
<body data-theme="deser">
<div class="lab-topbar"><a class="lab-back" href="/challenges">&larr; ZeroDay Academy</a><span class="name">MyAccount</span><span class="tag">/labs/insecure-deserialization</span></div>
<div class="lab-wrap">
  <div class="lab-card">
    <h1>Account Overview</h1>
    <% if (error) { %><div class="lab-alert error"><%= error %></div><% } %>
    <% if (session) { %>
      <div style="display:flex;align-items:center;gap:1rem;margin-bottom:1rem;">
        <div style="width:48px;height:48px;border-radius:50%;background:var(--accent);display:flex;align-items:center;justify-content:center;font-size:1.4rem;color:#fff;"><%= (session.username || '?')[0].toUpperCase() %></div>
        <div>
          <div style="font-weight:600;font-size:1.1rem;"><%= session.username %></div>
          <div class="lab-meta">Role: <%= session.role %></div>
        </div>
      </div>
      <% if (flag) { %>
        <div class="lab-alert success">Access granted. Flag: <span class="lab-flag"><%= flag %></span></div>
      <% } %>
    <% } %>
  </div>

  <div class="lab-card">
    <h2>Quick Links</h2>
    <ul class="lab-list">
      <li><a href="#">Dashboard</a></li>
      <li><a href="#">Profile Settings</a></li>
      <li><a href="#">Billing & Invoices</a></li>
      <li><a href="#">Security</a></li>
    </ul>
  </div>

</body>
</html>
