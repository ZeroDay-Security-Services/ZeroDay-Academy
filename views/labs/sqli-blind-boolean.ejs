<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>OrderTrack — Lookup</title>
<link rel="stylesheet" href="/css/lab.css">
</head>
<body data-theme="injection">
<div class="lab-topbar"><a class="lab-back" href="/challenges">&larr; ZeroDay Academy</a><span class="name">OrderTrack</span><span class="tag">/labs/sqli-blind-boolean</span></div>
<div class="lab-wrap">
  <div class="lab-card">
    <h1>Order Lookup</h1>
    <p>Enter your order ID to check its status.</p>
    <form method="POST" action="/labs/sqli-blind-boolean/lookup">
      <label>Order ID</label>
      <input name="id" value="<%= id %>" placeholder="e.g. 1001" autocomplete="off">
      <button type="submit">Look up</button>
    </form>
    <% if (error) { %><div class="lab-alert error"><%= error %></div><% } %>
    <% if (found !== null) { %>
      <div class="lab-alert <%= found ? 'success' : 'info' %>"><%= found ? 'Order found.' : 'No order found with that ID.' %></div>
    <% } %>
  </div>

  <div class="lab-card">
    <h2>Submit extracted value</h2>
    <form method="POST" action="/labs/sqli-blind-boolean/check">
      <label>Answer</label>
      <input name="answer" placeholder="Enter the extracted value" autocomplete="off">
      <button type="submit">Check</button>
    </form>
    <% if (checkResult) { %>
      <div class="lab-alert <%= checkResult.correct ? 'success' : 'error' %>">
        <%= checkResult.correct ? 'Correct!' : 'Incorrect.' %>
        <% if (checkResult.flag) { %><br>Flag: <span class="lab-flag"><%= checkResult.flag %></span><% } %>
      </div>
    <% } %>
  </div>

</body>
</html>
