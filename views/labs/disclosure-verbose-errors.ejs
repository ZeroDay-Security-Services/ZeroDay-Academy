<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DataLookup — Record Search</title>
<link rel="stylesheet" href="/css/lab.css">
</head>
<body data-theme="disclosure">
<div class="lab-topbar"><a class="lab-back" href="/challenges">&larr; ZeroDay Academy</a><span class="name">DataLookup</span><span class="tag">/labs/disclosure-verbose-errors</span></div>
<div class="lab-wrap">
  <div class="lab-card">
    <h1>Record Search</h1>
    <p>Look up a record by ID.</p>
    <form method="POST" action="/labs/disclosure-verbose-errors/lookup">
      <label>Record ID</label>
      <input name="id" placeholder="Enter record ID" autocomplete="off">
      <button type="submit">Look up</button>
    </form>
  </div>

  <% if (output) { %>
  <div class="lab-card">
    <h2>Result</h2>
    <pre style="white-space:pre-wrap;word-break:break-all;font-size:0.85rem;"><%= output %></pre>
  </div>
  <% } %>

</body>
</html>
