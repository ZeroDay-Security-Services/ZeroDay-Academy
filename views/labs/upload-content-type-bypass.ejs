<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MediaVault — Upload</title>
<link rel="stylesheet" href="/css/lab.css">
</head>
<body data-theme="upload">
<div class="lab-topbar"><a class="lab-back" href="/challenges">&larr; ZeroDay Academy</a><span class="name">MediaVault</span><span class="tag">/labs/upload-content-type-bypass</span></div>
<div class="lab-wrap">
  <div class="lab-card">
    <h1>Upload Avatar</h1>
    <p>Only PNG and JPEG images are accepted.</p>
    <form id="uploadForm">
      <label>File content</label>
      <textarea id="fileContent" rows="4" placeholder="File content here"></textarea>
      <label>Filename</label>
      <input id="uploadFilename" placeholder="avatar.png">
      <button type="submit">Upload</button>
    </form>
    <% if (error) { %><div class="lab-alert error"><%= error %></div><% } %>
  </div>

  <div class="lab-card">
    <h2>Uploaded Files</h2>
    <ul class="lab-list">
      <% files.forEach(f => { %>
        <li><a href="/labs/upload-content-type-bypass/view/<%= f._id %>" target="_blank"><%= f.filename %></a> <span class="lab-meta">(<%= f.contentType %>)</span></li>
      <% }) %>
      <% if (files.length === 0) { %><li class="lab-meta">No files uploaded.</li><% } %>
    </ul>
  </div>
</div>

<script>
  document.getElementById('uploadForm').addEventListener('submit', function(e) {
    e.preventDefault();
    var content = document.getElementById('fileContent').value;
    var filename = document.getElementById('uploadFilename').value || 'avatar.png';
    fetch('/labs/upload-content-type-bypass/upload?filename=' + encodeURIComponent(filename), {
      method: 'POST',
      headers: { 'Content-Type': 'text/plain', 'X-Declared-Type': 'image/png' },
      body: content
    }).then(function() { location.reload(); });
  });
</script>

</body>
</html>
