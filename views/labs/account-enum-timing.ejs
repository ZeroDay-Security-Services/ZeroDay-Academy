<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SecureAuth — Login</title>
<link rel="stylesheet" href="/css/lab.css">
</head>
<body data-theme="auth">
<div class="lab-topbar"><a class="lab-back" href="/challenges">&larr; ZeroDay Academy</a><span class="name">SecureAuth</span><span class="tag">/labs/account-enum-timing</span></div>
<div class="lab-wrap">
  <div class="lab-card">
    <h1>Login</h1>
    <form method="POST" action="/labs/account-enum-timing/login">
      <label>Username</label>
      <input name="username" autocomplete="off">
      <label>Password</label>
      <input name="password" type="password" autocomplete="off">
      <button type="submit">Sign in</button>
    </form>
    <% if (result && !result.checkOnly) { %>
      <div class="lab-alert error" style="margin-top:1rem;">
        <%= result.message %>
        <span class="lab-meta" style="float:right;"><%= result.elapsedMs %>ms</span>
      </div>
    <% } %>
  </div>

  <div class="lab-card">
    <h2>Confirm username</h2>
    <p>Once you've identified a valid username, submit it here.</p>
    <form method="POST" action="/labs/account-enum-timing/check-username">
      <label>Username guess</label>
      <input name="guess" autocomplete="off">
      <button type="submit">Check</button>
    </form>
    <% if (result && result.checkOnly) { %>
      <div class="lab-alert <%= result.valid ? 'success' : 'error' %>">
        <%= result.valid ? 'Valid username!' : 'Invalid username.' %>
        <% if (result.flag) { %><br>Flag: <span class="lab-flag"><%= result.flag %></span><% } %>
      </div>
    <% } %>
  </div>

</body>
</html>
