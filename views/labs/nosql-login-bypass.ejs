<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SecureVault — Login</title>
<link rel="stylesheet" href="/css/lab.css">
</head>
<body data-theme="nosql">
<div class="lab-topbar"><a class="lab-back" href="/challenges">&larr; ZeroDay Academy</a><span class="name">SecureVault</span><span class="tag">/labs/nosql-login-bypass</span></div>
<div class="lab-wrap">
  <div class="lab-card">
    <h1>Login</h1>
    <p>Sign in to access your vault.</p>

    <% if (result && result.notFound) { %>
      <div class="lab-alert error">Invalid username or password.</div>
    <% } %>
    <% if (result && !result.notFound) { %>
      <div class="lab-alert success">
        Welcome, <strong><%= result.username %></strong> (role: <%= result.role %>).
        <% if (result.flag) { %><br>Flag: <span class="lab-flag"><%= result.flag %></span><% } %>
      </div>
    <% } %>

    <form id="loginForm">
      <label>Username</label>
      <input id="username" name="username" autocomplete="off">
      <label>Password</label>
      <input id="password" name="password" type="password" autocomplete="off">
      <button type="submit">Sign in</button>
    </form>
  </div>
</div>

<script>
  document.getElementById('loginForm').addEventListener('submit', function(e) {
    e.preventDefault();
    var form = new FormData(this);
    fetch('/labs/nosql-login-bypass/login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ username: form.get('username'), password: form.get('password') })
    }).then(function(r) { return r.text(); }).then(function(html) {
      document.open(); document.write(html); document.close();
    });
  });
</script>

</body>
</html>
