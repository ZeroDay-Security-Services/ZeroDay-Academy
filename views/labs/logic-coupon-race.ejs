<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MegaStore — Coupon</title>
<link rel="stylesheet" href="/css/lab.css">
</head>
<body data-theme="logic">
<div class="lab-topbar"><a class="lab-back" href="/challenges">&larr; ZeroDay Academy</a><span class="name">MegaStore</span><span class="tag">/labs/logic-coupon-race</span></div>
<div class="lab-wrap">
  <div class="lab-card">
    <h1>Redeem Coupon</h1>
    <p>Coupon <strong>WELCOME10</strong> — 10% discount. Uses remaining: <strong><%= usesRemaining %></strong></p>
    <p>Your successful redemptions: <strong><%= successfulRedemptions %></strong></p>
    <% if (flag) { %>
      <div class="lab-alert success">Double redemption detected! Flag: <span class="lab-flag"><%= flag %></span></div>
    <% } %>
    <form method="POST" action="/labs/logic-coupon-race/redeem">
      <button type="submit">Redeem Coupon</button>
    </form>
  </div>

  <form method="POST" action="/labs/logic-coupon-race/reset"><button type="submit" class="secondary">Reset lab</button></form>

</body>
</html>
