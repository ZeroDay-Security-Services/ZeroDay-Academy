<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>GreetingCards — Send a Card</title>
<link rel="stylesheet" href="/css/lab.css">
</head>
<body data-theme="ssti">
<div class="lab-topbar"><a class="lab-back" href="/challenges">&larr; ZeroDay Academy</a><span class="name">GreetingCards</span><span class="tag">/labs/ssti-render</span></div>
<div class="lab-wrap">
  <div class="lab-card">
    <h1>Send a Greeting Card</h1>
    <p>Write a personalized message for your friend.</p>
    <form method="POST" action="/labs/ssti-render">
      <label>Your message</label>
      <textarea name="message" rows="4" placeholder="Happy birthday!"><%= message %></textarea>
      <button type="submit">Preview card</button>
    </form>
    <% if (error) { %><div class="lab-alert error"><%= error %></div><% } %>
  </div>

  <% if (output) { %>
  <div class="lab-card">
    <h2>Card Preview</h2>
    <pre style="white-space:pre-wrap;"><%= output %></pre>
  </div>
  <% } %>

</body>
</html>
