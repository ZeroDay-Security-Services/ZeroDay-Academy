<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CommentBoard — Community</title>
<link rel="stylesheet" href="/css/lab.css">
</head>
<body data-theme="xss">
<div class="lab-topbar"><a class="lab-back" href="/challenges">&larr; ZeroDay Academy</a><span class="name">CommentBoard</span><span class="tag">/labs/stored-xss</span></div>
<div class="lab-wrap">
  <% if (posted) { %><div class="lab-alert success">Comment posted.</div><% } %>

  <div class="lab-card">
    <h1>Leave a comment</h1>
    <form method="POST" action="/labs/stored-xss">
      <label>Name</label>
      <input name="author" placeholder="Your name">
      <label>Comment</label>
      <textarea name="body" placeholder="Say something..."></textarea>
      <button type="submit">Post comment</button>
    </form>
  </div>

  <div class="lab-card">
    <h2>Comments</h2>
    <ul class="lab-list">
      <% comments.forEach(c => { %>
        <li>
          <strong><%= c.author %></strong>
          <div class="lab-meta"><%= c.created_at %></div>
          <div><%- c.body %></div>
        </li>
      <% }) %>
      <% if (comments.length === 0) { %><li class="lab-meta">No comments yet. Be the first!</li><% } %>
    </ul>
  </div>

</body>
</html>
