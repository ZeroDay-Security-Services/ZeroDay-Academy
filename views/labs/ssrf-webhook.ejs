<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>WebhookTester — Verify</title>
<link rel="stylesheet" href="/css/lab.css">
</head>
<body data-theme="ssrf">
<div class="lab-topbar"><a class="lab-back" href="/challenges">&larr; ZeroDay Academy</a><span class="name">WebhookTester</span><span class="tag">/labs/ssrf-webhook</span></div>
<div class="lab-wrap">
  <div class="lab-card">
    <h1>Test Webhook</h1>
    <p>Verify that your webhook endpoint is reachable.</p>
    <form method="POST" action="/labs/ssrf-webhook">
      <label>Webhook URL</label>
      <input name="url" placeholder="https://your-service.com/callback" value="<%= url %>" autocomplete="off">
      <button type="submit">Test</button>
    </form>
    <% if (error) { %><div class="lab-alert error"><%= error %></div><% } %>
  </div>

  <% if (result) { %>
  <div class="lab-card">
    <h2>Response</h2>
    <p class="lab-meta">Status: <%= result.status %></p>
    <pre style="white-space:pre-wrap;word-break:break-all;font-size:0.85rem;"><%= result.body %></pre>
  </div>
  <% } %>

</body>
</html>
