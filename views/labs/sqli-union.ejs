<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MegaStore — Products</title>
<link rel="stylesheet" href="/css/lab.css">
</head>
<body data-theme="injection">
<div class="lab-topbar"><a class="lab-back" href="/challenges">&larr; ZeroDay Academy</a><span class="name">MegaStore</span><span class="tag">/labs/sqli-union</span></div>
<div class="lab-wrap">
  <div class="lab-card">
    <h1>Browse Products</h1>
    <form method="POST" action="/labs/sqli-union">
      <label>Category</label>
      <input name="category" placeholder="e.g. Electronics" value="<%= category %>">
      <label>Sort by</label>
      <select name="sort" style="margin-bottom:1rem;">
        <option value="name">Name</option>
        <option value="price_asc">Price: Low to High</option>
        <option value="price_desc">Price: High to Low</option>
      </select>
      <label>Max price</label>
      <input name="maxprice" type="number" placeholder="No limit" style="margin-bottom:1rem;">
      <button type="submit">Search</button>
    </form>
  </div>

  <% if (error) { %><div class="lab-card"><div class="lab-alert error"><%= error %></div></div><% } %>

  <% if (results && results.length > 0) { %>
  <div class="lab-card">
    <h2>Results</h2>
    <table class="lab-table">
      <tr><th>Name</th><th>Category</th><th>Price</th></tr>
      <% results.forEach(r => { %>
        <tr><td><%= r.name %></td><td><%= r.category %></td><td><%= r.price %></td></tr>
      <% }) %>
    </table>
  </div>
  <% } else if (results) { %>
  <div class="lab-card"><p class="lab-meta">No products found.</p></div>
  <% } %>

</body>
</html>
