<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SecureAuth — PIN Login</title>
<link rel="stylesheet" href="/css/lab.css">
</head>
<body data-theme="auth">
<div class="lab-topbar"><a class="lab-back" href="/challenges">&larr; ZeroDay Academy</a><span class="name">SecureAuth</span><span class="tag">/labs/no-rate-limit-bruteforce</span></div>
<div class="lab-wrap">
  <div class="lab-card">
    <h1>PIN Login</h1>
    <p>Enter your 4-digit PIN to access your account. There is no attempt counter or lockout.</p>
    <form method="POST" action="/labs/no-rate-limit-bruteforce/try-pin">
      <label>PIN</label>
      <input name="pin" type="text" inputmode="numeric" maxlength="4" placeholder="****" autocomplete="off">
      <button type="submit">Unlock</button>
    </form>
    <% if (result) { %>
      <div class="lab-alert <%= result.correct ? 'success' : 'error' %>" style="margin-top:1rem;">
        <%= result.correct ? 'Unlocked!' : 'Incorrect PIN.' %>
        <span class="lab-meta">(attempt <%= result.attempts %>)</span>
        <% if (result.flag) { %><br>Flag: <span class="lab-flag"><%= result.flag %></span><% } %>
      </div>
    <% } %>
  </div>

  <div class="lab-card">
    <h2>Brute-force harness</h2>
    <p>Because the endpoint accepts unlimited attempts, loop over the 0000–9999 keyspace. The button below runs a bounded sample; use the form above or a script to continue.</p>
    <button type="button" class="secondary" id="bruteBtn">Try 200 PINs</button>
    <pre class="lab-code" id="bruteOut" style="margin-top:0.8rem;">Not run yet.</pre>
  </div>

  <form method="POST" action="/labs/no-rate-limit-bruteforce/reset"><button type="submit" class="secondary">Reset lab</button></form>
</div>
<script>
  document.getElementById('bruteBtn').addEventListener('click', async function () {
    const out = document.getElementById('bruteOut');
    this.disabled = true;
    out.textContent = 'Trying PINs 0000-0199...';
    for (let pin = 0; pin < 200; pin += 1) {
      const value = String(pin).padStart(4, '0');
      const response = await fetch('/labs/no-rate-limit-bruteforce/try-pin', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: 'pin=' + value
      });
      const html = await response.text();
      const match = html.match(/ZDS\{[^}]+\}/);
      if (match) {
        out.textContent = 'PIN ' + value + ' unlocked the account.\nFLAG: ' + match[0];
        this.disabled = false;
        return;
      }
    }
    out.textContent = 'No hit in this sample. Continue with the next range or write a full script.';
    this.disabled = false;
  });
</script>
</body>
</html>
