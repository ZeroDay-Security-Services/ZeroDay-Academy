<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PrefSync — Preferences</title>
<link rel="stylesheet" href="/css/lab.css">
</head>
<body data-theme="proto">
<div class="lab-topbar"><a class="lab-back" href="/challenges">&larr; ZeroDay Academy</a><span class="name">PrefSync</span><span class="tag">/labs/prototype-pollution</span></div>
<div class="lab-wrap">
  <div class="lab-card">
    <h1>Update preferences</h1>
    <p>Submit JSON to merge into your saved preferences.</p>
    <form method="POST" action="/labs/prototype-pollution/merge">
      <label>Preferences JSON</label>
      <textarea name="json" rows="5">{"theme":"light"}</textarea>
      <button type="submit">Save</button>
    </form>
    <% if (error) { %><div class="lab-alert error"><%= error %></div><% } %>
    <% if (saved) { %><div class="lab-alert success" style="margin-top:1rem;">Preferences saved successfully.</div><% } %>
  </div>

  <div class="lab-card">
    <h2>Admin Panel</h2>
    <% if (isAdminNow) { %>
      <div class="lab-alert success">
        Access granted.
        <% if (flag) { %><br>Flag: <span class="lab-flag"><%= flag %></span><% } %>
      </div>
    <% } else { %>
      <div class="lab-alert info" style="opacity:0.6;">
        <span style="font-size:1.2rem;">🔒</span> Restricted — admin access required.
      </div>
    <% } %>
  </div>

</body>
</html>
