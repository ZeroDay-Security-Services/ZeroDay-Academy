<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>OrderFlow — Checkout</title>
<link rel="stylesheet" href="/css/lab.css">
</head>
<body data-theme="logic">
<div class="lab-topbar"><a class="lab-back" href="/challenges">&larr; ZeroDay Academy</a><span class="name">OrderFlow</span><span class="tag">/labs/logic-workflow-skip</span></div>
<div class="lab-wrap">
  <div class="lab-card">
    <h1>Checkout Wizard</h1>
    <div style="display:flex;gap:0.5rem;margin-bottom:1rem;flex-wrap:wrap;">
      <span class="lab-badge">1. Cart</span>
      <span class="lab-badge">2. Payment</span>
      <span class="lab-badge">3. Confirm</span>
    </div>

    <p>Cart total: <strong>$249.99</strong></p>
    <p class="lab-meta">Payment completed: <strong><%= state.paymentCompleted %></strong> · Order confirmed: <strong><%= state.orderConfirmed %></strong></p>

    <div style="display:flex;gap:0.5rem;margin-top:1rem;flex-wrap:wrap;">
      <form method="POST" action="/labs/logic-workflow-skip/pay">
        <button type="submit">Proceed to Payment</button>
      </form>
      <form method="POST" action="/labs/logic-workflow-skip/confirm">
        <button type="submit" class="secondary">Confirm order now</button>
      </form>
    </div>

    <% if (state.orderConfirmed) { %>
      <div class="lab-alert <%= flag ? 'success' : 'info' %>" style="margin-top:1rem;">
        Order confirmed! Payment: <%= state.paymentCompleted ? 'completed' : 'pending' %>
        <% if (flag) { %><br>Flag: <span class="lab-flag"><%= flag %></span><% } %>
      </div>
    <% } %>
  </div>

  <form method="POST" action="/labs/logic-workflow-skip/reset"><button type="submit" class="secondary">Reset lab</button></form>
</div>
</body>
</html>
