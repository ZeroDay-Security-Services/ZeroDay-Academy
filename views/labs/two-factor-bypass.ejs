<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SecureAuth — Two-Factor</title>
<link rel="stylesheet" href="/css/lab.css">
</head>
<body data-theme="auth">
<div class="lab-topbar"><a class="lab-back" href="/challenges">&larr; ZeroDay Academy</a><span class="name">SecureAuth</span><span class="tag">/labs/two-factor-bypass</span></div>
<div class="lab-wrap">
  <div class="lab-card">
    <h1>Two-Factor Authentication</h1>

    <% if (!step1Done) { %>
      <h2>Step 1: Login</h2>
      <form method="POST" action="/labs/two-factor-bypass/step1">
        <label>Username</label>
        <input name="username" autocomplete="off">
        <label>Password</label>
        <input name="password" type="password" autocomplete="off">
        <button type="submit">Continue</button>
      </form>
      <% if (result && result.error) { %><div class="lab-alert error"><%= result.error %></div><% } %>
    <% } else { %>
      <div class="lab-alert success" style="margin-bottom:1rem;">Step 1 complete. Enter your OTP.</div>
      <h2>Step 2: OTP Verification</h2>
      <form method="POST" action="/labs/two-factor-bypass/step2">
        <label>One-time code</label>
        <input name="otp" maxlength="6" placeholder="6-digit code" autocomplete="off">
        <button type="submit">Verify</button>
      </form>
      <% if (result && result.success === false) { %>
        <div class="lab-alert error">Invalid code.</div>
      <% } %>
      <% if (result && result.success) { %>
        <div class="lab-alert success">
          Authenticated!
          <% if (result.flag) { %><br>Flag: <span class="lab-flag"><%= result.flag %></span><% } %>
        </div>
      <% } %>
    <% } %>
  </div>

  <form method="POST" action="/labs/two-factor-bypass/reset"><button type="submit" class="secondary">Reset lab</button></form>

</body>
</html>
