<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SecureShop — Catalog</title>
<link rel="stylesheet" href="/css/lab.css">
</head>
<body data-theme="nosql">
<div class="lab-topbar"><a class="lab-back" href="/challenges">&larr; ZeroDay Academy</a><span class="name">SecureShop</span><span class="tag">/labs/nosql-search-injection</span></div>
<div class="lab-wrap">
  <div class="lab-card">
    <h1>Product Catalog</h1>
    <p>Browse our available products.</p>
    <ul class="lab-list">
      <% results.forEach(r => { %>
        <li><%= r.data.name %></li>
      <% }) %>
      <% if (results.length === 0) { %><li class="lab-meta">No products available.</li><% } %>
    </ul>
  </div>

</body>
</html>
