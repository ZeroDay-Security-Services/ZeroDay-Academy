<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SecureShop — Catalog</title>
<link rel="stylesheet" href="/css/lab.css">
</head>
<body data-theme="nosql">
<div class="lab-topbar"><a class="lab-back" href="/challenges">&larr; ZeroDay Academy</a><span class="name">SecureShop</span><span class="tag">/labs/nosql-search-injection</span></div>
<div class="lab-wrap">
  <div class="lab-card">
    <h1>Product Catalog</h1>
    <form method="GET" action="/labs/nosql-search-injection">
      <label>Product name contains</label>
      <input name="name" value="<%= typeof query.name === 'string' ? query.name : '' %>" placeholder="e.g. wallet" autocomplete="off">
      <label style="display:flex;gap:0.5rem;align-items:center;"><input type="checkbox" name="released" value="true" <%= query.released === undefined || query.released === 'true' ? 'checked' : '' %>> Only released products</label>
      <button type="submit">Search</button>
    </form>
    <p class="lab-meta">Query parameters are passed into the Mongo filter. Try <code>?released[$ne]=true</code> to expose unreleased records.</p>
  </div>

  <div class="lab-card">
    <h2>Results</h2>
    <ul class="lab-list">
      <% results.forEach(r => { %>
        <li>
          <strong><%= r.data.name %></strong>
          <div class="lab-meta">Released: <%= r.data.released %> · <%= r.data.price %></div>
        </li>
      <% }) %>
      <% if (results.length === 0) { %><li class="lab-meta">No products matched.</li><% } %>
    </ul>
  </div>

  <form method="POST" action="/labs/nosql-search-injection/reset"><button type="submit" class="secondary">Reset lab</button></form>
</div>
</body>
</html>
