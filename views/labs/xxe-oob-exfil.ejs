<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DataImporter — Blind Import</title>
<link rel="stylesheet" href="/css/lab.css">
</head>
<body data-theme="xxe">
<div class="lab-topbar"><a class="lab-back" href="/challenges">&larr; ZeroDay Academy</a><span class="name">DataImporter</span><span class="tag">/labs/xxe-oob-exfil</span></div>
<div class="lab-wrap">
  <div class="lab-card">
    <h1>DTD Server</h1>
    <p>Configure a DTD that will be served at <code>/labs/xxe-oob-exfil/evil.dtd</code>.</p>
    <form method="POST" action="/labs/xxe-oob-exfil/craft-dtd">
      <label>DTD Content</label>
      <textarea name="dtd" rows="5" placeholder="Paste your DTD here"><%= dtd %></textarea>
      <button type="submit" class="secondary">Save DTD</button>
    </form>
  </div>

  <div class="lab-card">
    <h2>Import XML</h2>
    <form method="POST" action="/labs/xxe-oob-exfil/import">
      <label>XML Payload</label>
      <textarea name="xml" rows="5" placeholder="Paste XML here"></textarea>
      <button type="submit">Submit</button>
    </form>
    <% if (result) { %>
      <div class="lab-alert <%= result.error ? 'error' : 'info' %>" style="margin-top:1rem;">
        <%= result.error || result.message %>
      </div>
    <% } %>
  </div>

  <div class="lab-card">
    <h2>Collector</h2>
    <p>Data received: <strong><%= received || 'none yet' %></strong></p>
    <p class="lab-meta">Check: <a href="/labs/xxe-oob-exfil/check">/labs/xxe-oob-exfil/check</a></p>
  </div>

  <form method="POST" action="/labs/xxe-oob-exfil/reset"><button type="submit" class="secondary">Reset lab</button></form>

</body>
</html>
