# Copy this file to .env and fill in real values. Never commit .env.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# development | production | test
NODE_ENV=development

# Local HTTP port. Render, Railway, Fly.io and similar platforms set this.
PORT=3000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# MongoDB connection string. In Atlas: Database > Connect > Drivers.
# Production requires this value. Development starts an in-memory MongoDB
# automatically when it is empty, but that database disappears on exit.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/zeroday_academy?retryWrites=true&w=majority

# ---------------------------------------------------------------------------
# Secrets (required in production)
# ---------------------------------------------------------------------------
# Long random strings, at least 16 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-session-secret
FLAG_SECRET=replace-with-a-different-long-random-flag-secret

# ---------------------------------------------------------------------------
# Founder administrator
# ---------------------------------------------------------------------------
ADMIN_EMAIL=founder.zeroday@gmail.com
ADMIN_USERNAME=founder

# Only read from the environment. Never commit a real password.
# At least 12 characters. Required by `npm run create-admin` and by the
# optional startup bootstrap below.
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters

# Set to true only for controlled provisioning or CI/QA. When true, server
# startup creates or promotes the founder account using the values above.
# An existing password is never changed unless it is reset explicitly.
BOOTSTRAP_ADMIN=false

# ---------------------------------------------------------------------------
# Lab instances
# ---------------------------------------------------------------------------
# Minutes before an untouched lab instance expires.
LAB_INSTANCE_TTL_MINUTES=120

# Maximum simultaneously active lab instances per user.
LAB_MAX_ACTIVE=6
